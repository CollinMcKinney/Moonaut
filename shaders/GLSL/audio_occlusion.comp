#version 430 core

layout(local_size_x = 8, local_size_y = 1, local_size_z = 1) in;

uniform samplerCube uProbeDepthCube;
uniform vec2        uProbeNearFar;
uniform vec3        uListenerPos;
uniform int         uNumVoices;

struct VoiceInput {
    vec3 worldPos;
    float _pad;
};
layout(std430, binding = 0) buffer VoiceInputBuffer {
    VoiceInput voices[];
};

struct PropagationOutput {
    float occlusion;
};
layout(std430, binding = 1) buffer PropagationOutputBuffer {
    PropagationOutput outputs[];
};

/* Linearize the hardware depth stored in the cube (perpendicular
 * distance to the face plane, in [0,1]) to world units. */
float probe_linearize(float z01, float near, float far) {
    float z = z01 * 2.0 - 1.0;
    return (2.0 * near * far) / (far + near - z * (far - near));
}

/* Distance from the listener to the first surface the probe observed
 * in direction 'dir'. Returns 1e10 for sky pixels (no hit). */
float probe_distance(vec3 dir) {
    float d = texture(uProbeDepthCube, dir).r;
    if (d >= 0.9999) return 1e10;
    float perp = probe_linearize(d, uProbeNearFar.x, uProbeNearFar.y);
    /* The cube stores perpendicular distance to each face; radial
     * distance is perp / cos(angle to face forward axis), and the
     * cos is exactly the dominant component of the normalized dir. */
    vec3 a = abs(dir);
    float dominant = max(a.x, max(a.y, a.z));
    return perp / max(dominant, 1e-4);
}

void main() {
    uint voice_idx = gl_GlobalInvocationID.x;
    if (voice_idx >= uint(uNumVoices)) return;

    vec3 source_world = voices[voice_idx].worldPos;
    vec3 to_source = source_world - uListenerPos;
    float source_dist = length(to_source);

    if (source_dist < 0.05) {
        outputs[voice_idx].occlusion = 0.0;
        return;
    }

    vec3 dir = to_source / source_dist;

    /* Ask the cube: how far does the ray from the listener in this
     * direction travel before hitting a surface? */
    float occluder_dist = probe_distance(dir);

    /* No occluder, or occluder is beyond the source — clear line. */
    if (occluder_dist >= source_dist - 0.05) {
        outputs[voice_idx].occlusion = 0.0;
        return;
    }

    /* Occluder sits between listener and source. We can't measure wall
     * thickness from a single sample, but the difference between source
     * distance and occluder distance is a decent proxy: a source just
     * past a thin wall reads as lightly occluded, a source deep behind
     * a wall reads as fully occluded. */
    float wall_thick = source_dist - occluder_dist;
    float occlusion = clamp(wall_thick / 8.0, 0.0, 1.0);

    outputs[voice_idx].occlusion = occlusion;
}