#version 430 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

uniform sampler2D uDepthTex;
uniform mat4 uViewProj;
uniform mat4 uInvViewProj;
uniform vec3 uListenerPos;
uniform int  uNumVoices;

struct VoiceInput {
    vec3 worldPos;
    float _pad;
};
layout(std430, binding = 0) buffer VoiceInputBuffer {
    VoiceInput voices[];
};

struct PortalCandidate {
    float dist;
    float pos_x;
    float pos_y;
    float pos_z;
};
layout(std430, binding = 3) buffer PortalCandidates {
    PortalCandidate candidates[];
};

vec3 world_from_uv_depth(vec2 uv, float depth) {
    float clip_z = depth * 2.0 - 1.0;
    vec4 clip = vec4(uv * 2.0 - 1.0, clip_z, 1.0);
    vec4 world = uInvViewProj * clip;
    return world.xyz / world.w;
}

void main() {
    uint voice_idx = gl_GlobalInvocationID.x;
    if (voice_idx >= uint(uNumVoices)) {
        return;
    }

    vec3 source_world = voices[voice_idx].worldPos;

    vec4 clip = uViewProj * vec4(source_world, 1.0);
    vec2 uv = clip.xy / clip.w;
    uv = uv * 0.5 + 0.5;
    float source_depth_01 = clip.z / clip.w * 0.5 + 0.5;

    if (clip.w <= 0.0 || uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
        candidates[voice_idx].dist = length(source_world - uListenerPos);
        candidates[voice_idx].pos_x = source_world.x;
        candidates[voice_idx].pos_y = source_world.y;
        candidates[voice_idx].pos_z = source_world.z;
        return;
    }

    ivec2 tex_size = textureSize(uDepthTex, 0);
    ivec2 center_pix = ivec2(uv * vec2(tex_size));
    float depth_at_center = texelFetch(uDepthTex, center_pix, 0).r;

    if (depth_at_center >= source_depth_01 - 0.001) {
        candidates[voice_idx].dist = 1e10;
        return;
    }

    // ---- Brute‑force all pixels, keep closest (by squared distance) ----
    float best_sq_dist = 1e10;
    vec2 best_uv = uv;

    for (int py = 0; py < tex_size.y; py++) {
        for (int px = 0; px < tex_size.x; px++) {
            vec2 sample_uv = vec2(px, py) / vec2(tex_size);
            float sample_depth = texelFetch(uDepthTex, ivec2(px, py), 0).r;

            if (sample_depth > source_depth_01 + 0.001) {
                vec2 delta = sample_uv - uv;
                float sq_dist = delta.x * delta.x + delta.y * delta.y;
                if (sq_dist < best_sq_dist) {
                    best_sq_dist = sq_dist;
                    best_uv = sample_uv;
                }
            }
        }
    }

    if (best_sq_dist < 1e9) {
        float best_depth = texelFetch(uDepthTex, ivec2(best_uv * vec2(tex_size)), 0).r;
        vec3 portal_world = world_from_uv_depth(best_uv, best_depth);
        float total_path = length(source_world - portal_world) + length(portal_world - uListenerPos);
        candidates[voice_idx].dist = total_path;
        candidates[voice_idx].pos_x = portal_world.x;
        candidates[voice_idx].pos_y = portal_world.y;
        candidates[voice_idx].pos_z = portal_world.z;
        return;
    }

    // ---- Fallback ----
    candidates[voice_idx].dist = length(source_world - uListenerPos);
    candidates[voice_idx].pos_x = source_world.x;
    candidates[voice_idx].pos_y = source_world.y;
    candidates[voice_idx].pos_z = source_world.z;
}