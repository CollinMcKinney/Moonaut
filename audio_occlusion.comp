#version 430 core

layout(local_size_x = 8, local_size_y = 1, local_size_z = 1) in;

uniform sampler2D uDepthTex;
uniform mat4 uViewProj;
uniform mat4 uInvViewProj;
uniform vec3 uListenerPos;
uniform int  uNumVoices;

struct VoiceInput {
    vec3 worldPos;
    float _pad;
};
layout(std430, binding = 0) buffer VoiceInputBuffer {
    VoiceInput voices[];
};

struct PropagationOutput {
    float occlusion;
};
layout(std430, binding = 1) buffer PropagationOutputBuffer {
    PropagationOutput outputs[];
};

vec3 world_from_uv_depth(vec2 uv, float depth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 world = uInvViewProj * clip;
    return world.xyz / world.w;
}

void main() {
    uint voice_idx = gl_GlobalInvocationID.x;
    if (voice_idx >= uint(uNumVoices)) return;

    vec3 source_world = voices[voice_idx].worldPos;
    vec4 clip = uViewProj * vec4(source_world, 1.0);
    vec2 uv = clip.xy / clip.w;
    uv = uv * 0.5 + 0.5;
    ivec2 tex_size = textureSize(uDepthTex, 0);
    ivec2 pix = ivec2(uv * vec2(tex_size));
    bool on_screen = (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0 && clip.w > 0.0);

    float occlusion = 0.0;

    if (on_screen) {
        float raw_depth = texelFetch(uDepthTex, pix, 0).r;
        vec3 occluder_world = world_from_uv_depth(uv, raw_depth);
        float occluder_dist = length(occluder_world - uListenerPos);
        float source_dist = length(source_world - uListenerPos);

        if (source_dist > occluder_dist + 0.05) {
            float wall_thick = source_dist - occluder_dist;
            occlusion = clamp(wall_thick / 8.0, 0.0, 1.0);
        }
    } else {
        float dist = length(source_world - uListenerPos);
        occlusion = clamp((dist - 0.5) / 20.0, 0.0, 0.4);
    }

    outputs[voice_idx].occlusion = occlusion;
}